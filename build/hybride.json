{
  "appId": "tn.sti.hybrideCorrecteur",
  "productName": "hybrideCorrecteur",
  "extraMetadata": {
    "correcteurMode": "hybride"
  },
  "directories": {
    "output": "dist/hybrideCorrecteur"
  },
  "files": [
    "src/**/*",
    "modeles/*.json",
    "package.json",
    "node_modules/**/*",
    "!tests",
    "!modeles/src",
    "!dist"
  ],
  "asar": true,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "signAndEditExecutable": true,
    "signExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "hybrideCorrecteur",
    "artifactName": "hybrideCorrecteur-Setup-${version}.exe"
  },
  "icon": "build/icon.png",
  "copyright": "© 2026 Mohamed Zouaghi"
}